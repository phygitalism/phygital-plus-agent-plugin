{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "phygital": {
      "type": "streamable-http",
      "url": "https://dev.phygital.plus/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["tasks:read", "tasks:write", "files:write", "offline_access"]
          }
        }
      }
    }
  }
}
